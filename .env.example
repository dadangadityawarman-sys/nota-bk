# Lokal development (SQLite, gampang, langsung jalan)
DATABASE_URL="file:./dev.db"

# Password admin sederhana untuk akses web (ganti dengan password sendiri)
ADMIN_PASSWORD="ganti-password-ini"

# --- Untuk PRODUCTION / deploy (lihat README.md) ---
# Ganti provider di prisma/schema.prisma jadi "postgresql", lalu isi DATABASE_URL
# dengan connection string dari Neon.tech (gratis), contoh:
# DATABASE_URL="postgresql://user:pass@ep-xxxx.neon.tech/notabk?sslmode=require"
